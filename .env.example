# Used by docker-compose
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# First administrator, created once if no administrator exists.
# Remove BOOTSTRAP_ADMIN_PASSWORD from this file after the first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# 0 = do not load the fictional sample data (recommended for a real deployment)
SEED_DEMO_DATA=0

# Only when NOT using docker-compose (a hosting service that gives you a database):
# DATABASE_URL=postgresql://user:password@host:5432/dbname